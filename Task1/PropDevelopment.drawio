    <mxCell id="7yt3_LGAnjsjhAHrShSh-100" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;публичные данные&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Из за не качественных или потерянных данных есть риск репутационных потерь&lt;/p&gt;" vertex="1">
      <mxGeometry height="120" width="360" x="1290" y="360" as="geometry" />
    </mxCell>
    <mxCell id="7yt3_LGAnjsjhAHrShSh-101" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;&lt;span style=&quot;text-align: center; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;внутренние данные&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/h1&gt;&lt;p&gt;Из за искаженных, ппотеранных, или не качественных данных приводят к не правильной аналитике и решениям команды&lt;/p&gt;" vertex="1">
      <mxGeometry height="120" width="360" x="1290" y="460" as="geometry" />
    </mxCell>
    <mxCell id="7yt3_LGAnjsjhAHrShSh-102" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;&lt;span style=&quot;font-weight: 400; text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;конфиденциальные данные&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Утечка данных здесь является ккрическим риском так как имеется информация которая подпадает под 152-фз и влечет правовые и финансовые последствия для организации&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
      <mxGeometry height="120" width="360" x="1290" y="580" as="geometry" />
    </mxCell>
    <mxCell id="7yt3_LGAnjsjhAHrShSh-103" parent="1" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1&gt;&lt;span style=&quot;font-weight: 400; text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;секретные данные&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;Утечка данных является критичным риском что ведет к серьезным последствиям организации или нарушения законодательства&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
      <mxGeometry height="120" width="360" x="1290" y="690" as="geometry" />
    </mxCell>
